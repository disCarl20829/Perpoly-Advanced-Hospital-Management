Options -Indexes
ServerSignature Off

# Protect sensitive files
<FilesMatch "\.(env|sql|log|md|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct access to include files
<FilesMatch "^(db|auth|func|rbac|chat-func|mailer)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# URL rewriting
RewriteEngine On
RewriteBase /hms/

# Redirect to HTTPS in production
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]